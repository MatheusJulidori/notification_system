# =================================
# APPLICATION CONFIGURATION
# =================================
NODE_ENV=development
PORT=4001
API_PREFIX=/api/v1

# =================================
# DATABASE CONFIGURATION
# =================================
DB_HOST=db
DB_PORT=5432
DB_EXTERNAL_PORT=5433
DB_USER=postgres
DB_PASSWORD=your_secure_password_here
DB_NAME=unified_notifications
AUTO_RUN_MIGRATIONS=false
DB_SYNCHRONIZE=false
DB_CONNECTION_TIMEOUT=60000
DB_IDLE_TIMEOUT=60000
DB_MAX_QUERY_EXECUTION_TIME=60000
DB_SCHEMA=public
DB_POOL_SIZE=20

# =================================
# JWT CONFIGURATION
# =================================
JWT_SECRET=your_jwt_secret_key_here

# =================================
# CSRF CONFIGURATION
# =================================
CSRF_SECRET=your_csrf_secret_key_here

# =================================
# SECURITY
# =================================
BCRYPT_ROUNDS=12

# =================================
# CORS CONFIGURATION
# =================================
CORS_ORIGIN=http://localhost:3000,http://localhost:4000

# =================================
# LOGGING CONFIGURATION
# =================================
LOG_LEVEL=debug

# =================================
# DEVELOPMENT TOOLS
# =================================
DEBUG_MODE=true
SWAGGER_ENABLED=true

# =================================
# MONITORING
# =================================
HEALTH_CHECK_ENDPOINT=/health
METRICS_ENDPOINT=/metrics

# =================================
# RATE LIMITING 
# =================================
RATE_LIMIT_TTL=60
RATE_LIMIT_LIMIT=100

# =================================
# REDIS CONFIGURATION 
# =================================
REDIS_HOST=redis
REDIS_PORT=6379

# =================================
# RABBITMQ CONFIGURATION 
# =================================
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_MANAGER_PORT=15672

# =================================
# PROMETHEUS CONFIGURATION 
# =================================
PROMETHEUS_HOST=prometheus
PROMETHEUS_PORT=9090

# =================================
# GRAFANA DASHBOARD CONFIGURATION 
# =================================
GRAFANA_HOST=grafana
GRAFANA_PORT=3000
GRAFANA_EXTERNAL_PORT=3001
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin

# =================================
# GRAFANA LOKI CONFIGURATION 
# =================================
LOKI_HOST=loki
LOKI_PORT=3100

# =================================
# GRAFANA PROMTAIL CONFIGURATION 
# =================================
PROMTAIL_HOST=promtail